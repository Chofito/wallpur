<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/notif_thumb"
        android:layout_width="36dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/notif_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingEnd="8dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <ImageButton
        android:id="@+id/notif_prev"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/notif_action_bg"
        android:contentDescription="@string/notif_prev"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_notif_prev" />

    <ImageButton
        android:id="@+id/notif_next"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/notif_action_bg"
        android:contentDescription="@string/notif_next"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_notif_next" />
</LinearLayout>
