<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+. See backup_rules.xml: media (filesDir/images) and the Room database are
   excluded from cloud backup and device transfer so a restore never brings database rows
   without their files. Users move their data with the in-app ZIP export/import.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="images" />
        <exclude domain="database" path="wallpurr.db" />
        <exclude domain="database" path="wallpurr.db-wal" />
        <exclude domain="database" path="wallpurr.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="images" />
        <exclude domain="database" path="wallpurr.db" />
        <exclude domain="database" path="wallpurr.db-wal" />
        <exclude domain="database" path="wallpurr.db-shm" />
    </device-transfer>
</data-extraction-rules>
