<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and lower (and API 28-30 full backup). Wallpurr's state is a Room database
   plus media in filesDir/images that must stay consistent with each other. The media easily
   exceeds the 25 MB cloud quota, and restoring database rows without their files would leave
   dangling references, so neither is backed up. The in-app ZIP export is the full backup.
-->
<full-backup-content>
    <exclude domain="file" path="images" />
    <exclude domain="database" path="wallpurr.db" />
    <exclude domain="database" path="wallpurr.db-wal" />
    <exclude domain="database" path="wallpurr.db-shm" />
</full-backup-content>
